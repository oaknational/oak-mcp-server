{
  "name": "@oaknational/result",
  "version": "0.0.0-development",
  "private": true,
  "description": "Result<T, E> type for explicit error handling without exceptions",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*",
    "src/**/*",
    "!**/*.test.ts",
    "!**/*.integration.test.ts"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "clean": "rm -rf dist .turbo",
    "type-check": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-mcp-server.git",
    "directory": "packages/result"
  },
  "bugs": {
    "url": "https://github.com/oaknational/oak-mcp-server/issues"
  },
  "homepage": "https://github.com/oaknational/oak-mcp-server/tree/main/packages/result#readme",
  "keywords": [
    "result",
    "error-handling",
    "functional",
    "typescript"
  ],
  "license": "MIT"
}
