{
  "name": "@oaknational/openapi-zod-client-adapter",
  "version": "0.0.0-development",
  "private": true,
  "description": "Adapter for openapi-zod-client that enforces Zod v3/v4 boundary",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc -p tsconfig.lint.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "openapi-zod-client": "1.18.3"
  },
  "peerDependencies": {
    "openapi3-ts": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "openapi3-ts": "^4.6.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-mcp-server.git",
    "directory": "packages/openapi-zod-client-adapter"
  },
  "bugs": {
    "url": "https://github.com/oaknational/oak-mcp-server/issues"
  },
  "homepage": "https://github.com/oaknational/oak-mcp-server/tree/main/packages/openapi-zod-client-adapter#readme",
  "keywords": [
    "openapi",
    "zod",
    "adapter",
    "code-generation"
  ],
  "license": "MIT"
}
