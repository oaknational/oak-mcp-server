{
  "name": "@oaknational/env",
  "version": "0.0.0-development",
  "private": true,
  "description": "Environment schema contracts for MCP applications",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./resolution": {
      "types": "./dist/resolution/index.d.ts",
      "import": "./dist/resolution.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "rm -rf dist .turbo",
    "build": "tsup && tsc --emitDeclarationOnly --project tsconfig.build.json",
    "type-check": "tsc -p tsconfig.lint.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@oaknational/observability": "workspace:*",
    "dotenv": "17.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "mcp",
    "environment",
    "env",
    "zod",
    "schemas",
    "contracts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-mcp-server.git",
    "directory": "packages/env"
  },
  "bugs": {
    "url": "https://github.com/oaknational/oak-mcp-server/issues"
  },
  "homepage": "https://github.com/oaknational/oak-mcp-server/tree/main/packages/env#readme"
}
