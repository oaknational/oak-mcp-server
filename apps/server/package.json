{
  "name": "@oaknational/mcp-server",
  "version": "0.0.0-development",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "pnpm exec tsx esbuild.config.ts",
    "build:sentry:configured": "pnpm exec tsx build-scripts/run-sentry-configured-build.ts",
    "build:widget": "vite build --config widget/vite.config.ts && pnpm exec tsx scripts/embed-widget-html.ts",
    "clean": "rm -rf dist .turbo .widget-build public/oak-ds public/oak-assets public/.oak-*",
    "dev": "pnpm exec tsx operations/development/http-dev.ts dev",
    "dev:auth": "pnpm exec tsx operations/development/http-dev.ts dev",
    "dev:auth:stub": "OAK_CURRICULUM_MCP_USE_STUB_TOOLS=true OAK_API_KEY=stub-api-key pnpm exec tsx operations/development/http-dev.ts dev",
    "dev:observe": "pnpm exec tsx operations/development/http-dev.ts observe",
    "dev:observe:noauth": "pnpm exec tsx operations/development/http-dev.ts observe-noauth",
    "dev:widget": "PORT=5173; PID=$(lsof -ti :$PORT 2>/dev/null); if [ -n \"$PID\" ]; then NAME=$(ps -p $PID -o comm= 2>/dev/null); echo \"Port $PORT blocked by process: PID=$PID command=$NAME\"; echo \"Run: kill $PID\"; exit 1; fi; vite dev --config widget/vite.config.ts",
    "dev:widget-in-host": "bash scripts/dev-widget-in-host.sh",
    "generate:server-json": "pnpm exec tsx scripts/generate-server-json.ts",
    "generate:tool-table": "pnpm exec tsx scripts/generate-served-tool-table.ts",
    "start": "bash scripts/start-server.sh",
    "prod:harness": "pnpm exec tsx scripts/server-harness.ts",
    "prod:requests": "pnpm exec tsx scripts/run-requests.ts",
    "prod:diagnostics": "pnpm build && pnpm prod:harness",
    "type-check": "tsc -p tsconfig.lint.json --noEmit && tsc -p widget/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:widget": "vitest run --config vitest.widget.config.ts",
    "test:widget:ui": "env -u NO_COLOR playwright test --config playwright.widget.config.ts --grep-invert @a11y",
    "test:widget:a11y": "env -u NO_COLOR playwright test --config playwright.widget.config.ts --grep @a11y",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "conformance": "tsx conformance/src/bin/mcp-conformance.ts",
    "test:smoke": "vitest run --config vitest.e2e.config.ts e2e-tests/in-process.smoke.e2e.test.ts"
  },
  "dependencies": {
    "@clerk/backend": "3.16.1",
    "@clerk/express": "2.1.52",
    "@clerk/mcp-tools": "0.6.0",
    "@elastic/elasticsearch": "9.5.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oaknational/build-metadata": "workspace:*",
    "@oaknational/curriculum-sdk": "workspace:*",
    "@oaknational/env": "workspace:*",
    "@oaknational/logger": "workspace:*",
    "@oaknational/oak-search-sdk": "workspace:*",
    "@oaknational/observability": "workspace:*",
    "@oaknational/posthog-node": "workspace:*",
    "@oaknational/result": "workspace:*",
    "@oaknational/sentry-node": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@sentry/node": "10.70.0",
    "@vercel/functions": "3.9.1",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-list-routes": "1.3.2",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@oaknational/sdk-codegen": "workspace:*",
    "@oaknational/widget-tokens": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@sentry/esbuild-plugin": "^5.4.0",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "node-mocks-http": "^1.18.1",
    "prettier": "~3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  },
  "description": "OAuth-enabled MCP server over HTTP for the Oak National Academy Curriculum API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-mcp-server.git",
    "directory": "apps/server"
  },
  "bugs": {
    "url": "https://github.com/oaknational/oak-mcp-server/issues"
  },
  "homepage": "https://github.com/oaknational/oak-mcp-server/tree/main/apps/server#readme",
  "keywords": [
    "mcp",
    "oauth",
    "http",
    "oak",
    "curriculum",
    "education"
  ],
  "license": "MIT"
}
