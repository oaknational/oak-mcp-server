{
  "name": "@oaknational/mcp-docs",
  "version": "0.0.0",
  "private": true,
  "description": "Developer documentation site for Oak National Academy's MCP server.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsx scripts/generate-reference.ts && next build && node scripts/csp.mts",
    "build:server-deps": "pnpm --filter '@oaknational/mcp-server^...' build",
    "preview": "node scripts/serve.mts",
    "test": "pnpm run build:server-deps && pnpm run build && vitest run --root ../.. apps/docs",
    "test:a11y": "playwright test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@oaknational/oak-components": "^3.25.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@oaknational/mcp-server": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "express": "5.2.1",
    "tsx": "^4.23.15"
  }
}
