{
  "scope": {
    "from": "@oaknational/",
    "to": "@oaknational/"
  },
  "repository": "https://github.com/oaknational/oak-mcp-server",
  "dropEverywhere": [
    {
      "path": "eslint.config.ts",
      "reason": "The root eslint.config.ts lints packages/**."
    }
  ],
  "removeScripts": ["lint", "lint:fix", "test:e2e"],
  "removeDependencies": [
    "@oaknational/eslint-plugin-standards",
    "@oaknational/workspace-config",
    "eslint",
    "globals"
  ],
  "textRewrites": [
    {
      "find": "@oaknational/env-resolution",
      "replace": "@oaknational/env/resolution"
    },
    {
      "find": "@example.ingest.sentry.io",
      "replace": "@localhost"
    },
    {
      "find": "@example.test",
      "replace": "@localhost"
    },
    {
      "find": "../../../docs/",
      "replace": "https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/{sha}/docs/"
    },
    {
      "find": "../../../../docs/",
      "replace": "https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/{sha}/docs/"
    },
    {
      "find": "../../../../../docs/",
      "replace": "https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/{sha}/docs/"
    },
    {
      "find": "../../../.agent/",
      "replace": "https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/{sha}/.agent/"
    },
    {
      "find": "../../../../.agent/",
      "replace": "https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/{sha}/.agent/"
    },
    {
      "find": "../../../../../.agent/",
      "replace": "https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/{sha}/.agent/"
    },
    {
      "find": "../../../apps/oak-curriculum-mcp-streamable-http/docs/observability.md",
      "replace": "https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/{sha}/apps/oak-curriculum-mcp-streamable-http/docs/observability.md"
    }
  ],
  "edits": [
    {
      "path": "tsconfig.json",
      "find": "\"extends\": \"../../../tsconfig.base.json\",",
      "replace": "\"compilerOptions\": {\n    \"erasableSyntaxOnly\": true,\n    \"target\": \"ES2023\",\n    \"module\": \"ESNext\",\n    \"lib\": [\"ES2023\"],\n    \"moduleResolution\": \"bundler\",\n    \"types\": [\"node\"],\n    \"resolveJsonModule\": true,\n    \"declaration\": true,\n    \"declarationMap\": true,\n    \"esModuleInterop\": true,\n    \"forceConsistentCasingInFileNames\": true,\n    \"strict\": true,\n    \"noUnusedLocals\": true,\n    \"noUnusedParameters\": true,\n    \"noImplicitReturns\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"skipLibCheck\": true\n  },"
    },
    {
      "path": "vitest.config.ts",
      "find": "@oaknational/workspace-config/vitest",
      "replace": "../vitest.preset"
    },
    {
      "path": "tsup.config.ts",
      "find": "@oaknational/workspace-config/tsup",
      "replace": "../tsup.preset"
    }
  ],
  "packages": [
    {
      "name": "result",
      "to": "packages/result",
      "sources": [
        {
          "from": "packages/core/result"
        }
      ],
      "edits": [
        {
          "path": "src/unwrapping.ts",
          "find": "eslint-disable-next-line @oaknational/no-throw-statement",
          "replace": "",
          "wholeLine": true
        }
      ]
    },
    {
      "name": "observability",
      "to": "packages/observability",
      "sources": [
        {
          "from": "packages/core/observability"
        }
      ],
      "supplied": [
        {
          "from": "tools/import-from-ooce/supplied/type-safe-observability.ts",
          "to": "src/type-safe.ts"
        }
      ],
      "removeDependencies": ["@oaknational/type-helpers"],
      "edits": [
        {
          "path": "src/json-sanitisation.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./type-safe.js'"
        },
        {
          "path": "src/redaction.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./type-safe.js'"
        },
        {
          "path": "README.md",
          "find": "`@oaknational/type-helpers`, ",
          "replace": ""
        }
      ]
    },
    {
      "name": "env",
      "to": "packages/env",
      "sources": [
        {
          "from": "packages/core/env"
        },
        {
          "from": "packages/libs/env-resolution",
          "moves": {
            "src/": "src/resolution/",
            "tests/": "tests/resolution/",
            "README.md": "src/resolution/README.md"
          },
          "drop": [
            {
              "path": "package.json",
              "reason": "Dependencies merged into the env package.json."
            },
            {
              "path": "tsconfig.json",
              "reason": "The env package's own file covers the merged tree."
            },
            {
              "path": "tsconfig.build.json",
              "reason": "The env package's own file covers the merged tree."
            },
            {
              "path": "tsconfig.lint.json",
              "reason": "The env package's own file covers the merged tree."
            },
            {
              "path": "tsup.config.ts",
              "reason": "The env package's own file covers the merged tree."
            },
            {
              "path": "vitest.config.ts",
              "reason": "The env package's own file covers the merged tree."
            }
          ]
        }
      ],
      "edits": [
        {
          "path": "tests/resolution/app-root.integration.test.ts",
          "find": "'../src/",
          "replace": "'../../src/resolution/"
        },
        {
          "path": "tests/resolution/repo-root.integration.test.ts",
          "find": "'../src/",
          "replace": "'../../src/resolution/"
        },
        {
          "path": "tests/resolution/resolve-env.integration.test.ts",
          "find": "'../src/",
          "replace": "'../../src/resolution/"
        },
        {
          "path": "tests/resolution/warnings-channel.unit.test.ts",
          "find": "'../src/",
          "replace": "'../../src/resolution/"
        },
        {
          "path": "tsup.config.ts",
          "find": "createLibConfig()",
          "replace": "createLibConfig({\n  entry: { index: 'src/index.ts', resolution: 'src/resolution/index.ts' },\n  external: ['node:fs', 'node:path'],\n})"
        },
        {
          "path": "src/root-package-version.ts",
          "find": "'../../../../package.json'",
          "replace": "'../../../package.json'"
        },
        {
          "path": "tests/root-package-version.unit.test.ts",
          "find": "'../../../../package.json'",
          "replace": "'../../../package.json'"
        }
      ],
      "exports": {
        "./resolution": {
          "types": "./dist/resolution/index.d.ts",
          "import": "./dist/resolution.js"
        }
      }
    },
    {
      "name": "build-metadata",
      "to": "packages/build-metadata",
      "sources": [
        {
          "from": "packages/core/build-metadata"
        }
      ]
    },
    {
      "name": "logger",
      "to": "packages/logger",
      "sources": [
        {
          "from": "packages/libs/logger"
        }
      ],
      "supplied": [
        {
          "from": "tools/import-from-ooce/supplied/type-safe-logger.ts",
          "to": "src/type-safe.ts"
        },
        {
          "from": "tools/import-from-ooce/supplied/logger-file-sink-stream-errors.test-source.ts",
          "to": "src/file-sink-stream-errors.unit.test.ts"
        }
      ],
      "removeDependencies": ["@oaknational/type-helpers"],
      "edits": [
        {
          "path": "src/error-normalisation-fields.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./type-safe.js'"
        },
        {
          "path": "src/error-normalisation.unit.test.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./type-safe.js'"
        },
        {
          "path": "src/file-sink.ts",
          "find": "  readonly end: (cb?: () => void) => SimpleWriteStream;",
          "replace": "  readonly end: (cb?: () => void) => SimpleWriteStream;\n  readonly on: (event: 'error', listener: (error: Error) => void) => unknown;",
          "reason": "A write stream error, such as a log path that is a directory or cannot be written, is reported through console.error instead of crashing the process. OOCE has the same bug. MCP-853."
        },
        {
          "path": "src/file-sink.ts",
          "find": "    const stream = fs.createWriteStream(filePath, { flags });",
          "replace": "    const stream = fs.createWriteStream(filePath, { flags });\n    stream.on('error', (error) => {\n      console.error('Log file stream failed', { path: filePath, error: error.message });\n    });",
          "reason": "A write stream error, such as a log path that is a directory or cannot be written, is reported through console.error instead of crashing the process. OOCE has the same bug. MCP-853."
        },
        {
          "path": "src/node.ts",
          "find": "      return adaptWriteStream(stream);\n    },\n  };",
          "replace": "      return adaptWriteStream(stream);\n    },\n    on: (event, listener) => stream.on(event, listener),\n  };",
          "reason": "The Node stream adapter passes the stream's error event to the file sink. MCP-853."
        },
        {
          "path": "src/file-sink.unit.test.ts",
          "find": "    end: mockEnd,\n  };",
          "replace": "    end: mockEnd,\n    on: vi.fn(),\n  };",
          "reason": "The stream fake gains the on method that the stream interface now requires. MCP-853."
        }
      ]
    },
    {
      "name": "sentry-node",
      "to": "packages/sentry-node",
      "sources": [
        {
          "from": "packages/libs/sentry-node"
        }
      ],
      "supplied": [
        {
          "from": "tools/import-from-ooce/supplied/type-safe-sentry-node.ts",
          "to": "src/type-safe.ts"
        }
      ],
      "removeDependencies": ["@oaknational/type-helpers", "@sentry/cli"],
      "edits": [
        {
          "path": "src/runtime-redaction.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./type-safe.js'"
        },
        {
          "path": "src/runtime-sinks.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./type-safe.js'"
        },
        {
          "path": "src/runtime-sdk.ts",
          "find": "sendDefaultPii: config.sendDefaultPii,",
          "wholeLine": true,
          "replace": "    // eslint-disable-next-line @typescript-eslint/no-deprecated -- the option OOCE ships; moving to dataCollection changes what Sentry records, so it is a follow-up\n    sendDefaultPii: config.sendDefaultPii,"
        }
      ],
      "drop": [
        {
          "path": ".sentryclirc",
          "reason": "It names a real Sentry organisation and host."
        }
      ]
    },
    {
      "name": "posthog-node",
      "to": "packages/posthog-node",
      "sources": [
        {
          "from": "packages/libs/posthog-node"
        }
      ],
      "edits": [
        {
          "path": "src/client-product-selection.ts",
          "find": "s direction) from PostHog's published resolver and its fixtures",
          "replace": " * as a product decision) from PostHog's published resolver and its fixtures",
          "wholeLine": true
        }
      ]
    },
    {
      "name": "openapi-zod-client-adapter",
      "to": "packages/openapi-zod-client-adapter",
      "sources": [
        {
          "from": "packages/core/openapi-zod-client-adapter"
        }
      ],
      "edits": [
        {
          "path": "src/endpoint-types.ts",
          "find": "users/:id",
          "replace": "members/:id",
          "reason": "The example path matches the pre-commit personal-data scrub pattern for home directories, so it is renamed. No test reads it."
        }
      ]
    },
    {
      "name": "graph-core",
      "to": "packages/graph-core",
      "sources": [
        {
          "from": "packages/core/graph-core"
        }
      ],
      "supplied": [
        {
          "from": "tools/import-from-ooce/supplied/type-safe-graph-core.ts",
          "to": "src/type-safe.ts"
        }
      ],
      "removeDependencies": ["@oaknational/type-helpers"],
      "edits": [
        {
          "path": "src/vocab/registry.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'../type-safe.js'"
        },
        {
          "path": "src/vocab/index.unit.test.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'../type-safe.js'"
        }
      ]
    },
    {
      "name": "sdk-codegen",
      "to": "packages/codegen",
      "sources": [
        {
          "from": "packages/sdks/oak-sdk-codegen"
        }
      ],
      "supplied": [
        {
          "from": "tools/import-from-ooce/supplied/type-helpers.ts",
          "to": "src/types/helpers/type-safe.ts"
        },
        {
          "from": "tools/import-from-ooce/supplied/codegen-prettier.config.mjs",
          "to": "prettier.config.mjs"
        },
        {
          "from": "tools/import-from-ooce/supplied/codegen-drift.test-source.ts",
          "to": "tests/drift.test.ts"
        }
      ],
      "removeDependencies": ["@oaknational/type-helpers"],
      "edits": [
        {
          "path": "src/types/helpers/type-helpers.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./type-safe.js'"
        },
        {
          "path": "src/synonym-export.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./types/helpers/type-helpers.js'"
        },
        {
          "path": "tsconfig.lint.json",
          "find": ", \"src/generated/vocab/**\", \"src/vocab-data.ts\"]",
          "replace": "]",
          "reason": "The type-check covers the generated vocab modules too, as the repository's type-check coverage test requires. They type-check clean."
        },
        {
          "path": "reference/README.md",
          "find": "(../../../../.gitignore)",
          "replace": "(../../../.gitignore)",
          "reason": "The link points at this repository's root .gitignore, which carries the same reference rule, one level nearer than in OOCE."
        },
        {
          "path": "src/synonyms/README.md",
          "find": "(../../../../../apps/oak-search-cli/docs/SYNONYMS.md)",
          "replace": "(https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/d5846cf6f37270c73291640a526124429369ee97/apps/oak-search-cli/docs/SYNONYMS.md)",
          "reason": "The search app stays in OOCE, so the link points at its file at the pinned SHA."
        },
        {
          "path": "code-generation/test-fixtures.ts",
          "find": "users/{id}",
          "replace": "members/{id}",
          "reason": "The example path matches the pre-commit personal-data scrub pattern for home directories, so it is renamed. No test reads it."
        }
      ],
      "drop": [
        {
          "path": "vitest.e2e.config.ts",
          "reason": "It extends the e2e preset in OOCE's workspace-config, which this repository does not carry. The codegen e2e lane is deferred to MCP-861."
        },
        {
          "path": "e2e-tests/scripts/codegen-core.e2e.test.ts",
          "reason": "Its config is dropped. The codegen e2e lane is deferred to MCP-861."
        }
      ],
      "keepText": [
        {
          "path": "code-generation/typegen/search/generate-search-index-docs.ts",
          "reason": "The ../../../../docs/ paths are output paths into the package's own generated docs folder, not links into OOCE."
        },
        {
          "path": "code-generation/typegen/search/generate-search-modules.unit.test.ts",
          "reason": "The ../../../../docs/ paths are output paths into the package's own generated docs folder, not links into OOCE."
        },
        {
          "path": "code-generation/typegen/search/generate-search-response-docs.ts",
          "reason": "The ../../../../docs/ paths are output paths into the package's own generated docs folder, not links into OOCE."
        }
      ]
    },
    {
      "name": "graph-corpus-sdk",
      "to": "packages/graph-corpus-sdk",
      "sources": [
        {
          "from": "packages/sdks/graph-corpus-sdk"
        }
      ]
    },
    {
      "name": "curriculum-sdk",
      "to": "packages/curriculum-sdk",
      "sources": [
        {
          "from": "packages/sdks/oak-curriculum-sdk"
        }
      ],
      "supplied": [
        {
          "from": "tools/import-from-ooce/supplied/type-helpers.ts",
          "to": "src/types/helpers/type-safe.ts"
        }
      ],
      "removeDependencies": ["@oaknational/type-helpers"],
      "edits": [
        {
          "path": "src/types/helpers/type-helpers.ts",
          "find": "'@oaknational/type-helpers'",
          "replace": "'./type-safe.js'"
        },
        {
          "path": "tsconfig.lint.json",
          "find": "    \"bin/**/*.ts\",\n",
          "replace": "    \"bin/**/*.ts\",\n    \"examples/**/*.ts\",\n",
          "reason": "The type-check covers the client example too, as the repository's type-check coverage test requires. It type-checks clean."
        },
        {
          "path": "docs/mcp/README.md",
          "find": "3. Run `pnpm sdk-codegen` to regenerate tool descriptors\n4. Verify the tool now has `securitySchemes: [{ type: 'noauth' }]`\n",
          "replace": "<!-- markdownlint-disable MD029 -->\n\n3. Run `pnpm sdk-codegen` to regenerate tool descriptors\n4. Verify the tool now has `securitySchemes: [{ type: 'noauth' }]`\n\n<!-- markdownlint-enable MD029 -->\n",
          "reason": "The list continues after an unindented code block, which the repository's markdownlint rejects. The disable pair keeps OOCE's text and rendering."
        },
        {
          "path": "tsconfig.json",
          "find": "    \"docs/_typedoc_src/**/*.ts\"\n",
          "replace": "    \"docs/_typedoc_src/**/*.ts\",\n    \"examples/**/*.ts\"\n",
          "reason": "ESLint's typed rules resolve each file through the package tsconfig.json, so it must cover the client example."
        },
        {
          "path": "docs/logging-guide.md",
          "find": "(../../../libs/logger/README.md)",
          "replace": "(../../logger/README.md)",
          "reason": "The logger package moved to packages/logger in this repository."
        },
        {
          "path": "docs/logging-guide.md",
          "find": "(../../../../apps/oak-curriculum-mcp-streamable-http/README.md)",
          "replace": "(https://github.com/oaknational/oak-open-curriculum-ecosystem/blob/d5846cf6f37270c73291640a526124429369ee97/apps/oak-curriculum-mcp-streamable-http/README.md)",
          "reason": "The HTTP server has not moved yet, so the link points at its OOCE README at the pinned SHA."
        }
      ]
    }
  ]
}
