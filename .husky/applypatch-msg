#!/usr/bin/env sh

# Refuse mailbox applies (git am) on main before the patch is applied. This is the first git am hook, so the guard that runs is always the committed one.
export GUARD_BRANCH=""
export GUARD_HINT="Abort this apply (git am --abort), then re-run it on a branch (git switch -c <branch>)."
# shellcheck source=refuse-commit-on-main.sh
. .husky/refuse-commit-on-main.sh
