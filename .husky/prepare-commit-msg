#!/usr/bin/env sh

# Refuse sequencer commits (cherry-pick, revert) on main. They never reach pre-commit, and a non-zero exit here aborts the commit.
export GUARD_BRANCH=""
export GUARD_HINT="Abort first (git cherry-pick --abort / git revert --abort), then re-run on a branch."
# shellcheck source=refuse-commit-on-main.sh
. .husky/refuse-commit-on-main.sh
