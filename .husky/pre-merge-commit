#!/usr/bin/env sh

# Refuse merge commits on main. A clean git merge (including git pull on a diverged main) fires this hook, not pre-commit.
export GUARD_BRANCH=""
export GUARD_HINT="Abort the merge (git merge --abort), then merge on a branch and land via PR."
# shellcheck source=refuse-commit-on-main.sh
. .husky/refuse-commit-on-main.sh
